# ------------------------------------------------------------------------------
# CRM Florista B2B — variáveis de ambiente
# Copia para .env e preenche. NUNCA committar o .env real.
# ------------------------------------------------------------------------------

# Postgres (Supabase local em dev: supabase start)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Better Auth
BETTER_AUTH_SECRET="change-me-min-32-chars-aaaaaaaaaaaaaaaaaaaa"
BETTER_AUTH_URL="http://localhost:3001"

# Backend
PORT=3001
FRONTEND_URL="http://localhost:5173"
LOG_LEVEL="info"
NODE_ENV="development"
# AI service (Fase 4 §10.8): URL do ai-service + segredo HMAC partilhado.
AI_SERVICE_URL="http://localhost:3002"
AI_HMAC_SECRET="change-me-min-32-chars-bbbbbbbbbbbbbbbbbbbb"

# AI Service (Fase 4 §10.8)
AI_SERVICE_PORT=3002
# Mesmo valor que o AI_HMAC_SECRET do backend.
AI_HMAC_SECRET="change-me-min-32-chars-bbbbbbbbbbbbbbbbbbbb"
BACKEND_URL="http://localhost:3001"
# mock = determinístico sem API keys (CI/E2E); live = OpenAI real.
AI_PROVIDER="mock"
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# OPENAI_API_KEY="sk-..."  # obrigatório quando AI_PROVIDER=live

# Frontend (Vite injecta apenas variáveis VITE_*)
VITE_API_URL="http://localhost:3001"

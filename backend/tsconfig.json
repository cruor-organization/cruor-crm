{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",

    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // exactOptionalPropertyTypes: desligado — Prisma update types tratam ausência
    // de chave e `undefined` da mesma forma, e Zod `.optional()` emite `T | undefined`.
    // Manter true causa fricção em todo o stack sem benefício real.
    "exactOptionalPropertyTypes": false,

    "declaration": false,
    "declarationMap": false,
    "verbatimModuleSyntax": false,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist"]
}

// CRM Florista B2B — schema Prisma
//
// Fase 0: tabelas Better Auth (user, session, account, verification,
//          organization, member, invitation).
// Fase 1: Suppliers, Customers + Leads + Activities, Products + variants/media/votes,
//          Bundles, AuditLog.
// Fase 2: StockLocation, StockLevel, StockMovement, PriceList + lines,
//          CustomerSpecialPrice. Hard invariants §7.5/§10.4: qty>=0 (CHECK),
//          reservas atómicas via SELECT … FOR UPDATE, price floor landed × 1.10.
//
// pgvector está habilitado via `previewFeatures` + `extensions`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ----------------------------------------------------------------------------
// Better Auth — core
// ----------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // admin plugin
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions             Session[]
  accounts             Account[]
  memberships          Member[]
  invitations          Invitation[]           @relation("InvitationInviter")
  assignedCustomers    Customer[]             @relation("CustomerSalesRep")
  assignedLeads        CustomerLead[]         @relation("LeadSalesRep")
  activities           CustomerActivity[]
  productVotes         ProductVote[]
  auditLogs            AuditLog[]
  stockMovementsActed  StockMovement[]        @relation("StockMovementActor")
  specialPricesCreated CustomerSpecialPrice[] @relation("SpecialPriceCreator")
  customerOrders       CustomerOrder[]        @relation("CustomerOrderSalesRep")
  payments             Payment[]              @relation("PaymentActor")

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  impersonatedBy       String?
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ----------------------------------------------------------------------------
// Better Auth — organization plugin (member.role = enum §8)
// ----------------------------------------------------------------------------

model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members               Member[]
  invitations           Invitation[]
  suppliers             Supplier[]
  customers             Customer[]
  leads                 CustomerLead[]
  activities            CustomerActivity[]
  products              Product[]
  bundles               Bundle[]
  auditLogs             AuditLog[]
  stockLocations        StockLocation[]
  stockLevels           StockLevel[]
  stockMovements        StockMovement[]
  priceLists            PriceList[]
  priceListLines        PriceListLine[]
  customerSpecialPrices CustomerSpecialPrice[]
  customerOrders        CustomerOrder[]
  returns               Return[]
  quotes                Quote[]
  alibabaOrders         AlibabaOrder[]
  invoices              Invoice[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  // Valores válidos (configurados no organization plugin):
  // OWNER, ADMIN, SALES_MANAGER, SALES_REP, WAREHOUSE, MARKETING, VIEWER (§8)
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ----------------------------------------------------------------------------
// Domínio Fase 1 — Suppliers (§10.2, §7.1)
// ----------------------------------------------------------------------------

enum SupplierType {
  ALIBABA_SELLER
  EU_IMPORTER
  DIRECT_MANUFACTURER
  DOMESTIC
}

enum Incoterm {
  FOB
  CIF
  EXW
  DAP
  DDP
}

model Supplier {
  id                  String       @id @default(cuid())
  organizationId      String
  name                String
  legalName           String?
  country             String       @db.Char(2) // ISO 3166-1 alpha-2
  type                SupplierType
  taxId               String?
  // Contactos: [{ kind: "email"|"phone"|"wechat"|"whatsapp"|"alibaba_chat", value, primary }]
  contacts            Json         @default("[]")
  paymentTerms        String?
  incoterms           Incoterm?
  defaultLeadTimeDays Int?
  tags                String[]     @default([])
  notes               String?

  // Score derivado (atualizado em job; cacheado para querys).
  scoreCache       Int? // 0-100
  onTimeRate       Decimal? @db.Decimal(5, 4)
  defectRate       Decimal? @db.Decimal(5, 4)
  avgResponseHours Decimal? @db.Decimal(8, 2)

  status    String    @default("ACTIVE") // ACTIVE | INACTIVE | BLOCKED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products      Product[]
  alibabaOrders AlibabaOrder[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@map("supplier")
}

// ----------------------------------------------------------------------------
// Domínio Fase 1 — Customers (§10.3, §7.3)
// ----------------------------------------------------------------------------

enum CustomerBusinessType {
  PHYSICAL_SHOP
  EVENT_ATELIER
  DECORATOR
  HOTEL_RESTAURANT
  ONLINE_ONLY
  MIXED
}

enum PricingTier {
  STANDARD
  PROFESSIONAL
  KEY_ACCOUNT
  DISTRIBUTOR
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  AT_RISK
  CHURNED
  BLOCKED
}

enum PreferredChannel {
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Customer {
  id              String               @id @default(cuid())
  organizationId  String
  businessType    CustomerBusinessType
  legalName       String
  tradingName     String?
  taxId           String? // NIF/CIF
  taxCountry      String?              @db.Char(2)
  addresses       Json                 @default("[]") // billing + multi-shipping
  contacts        Json                 @default("[]")
  phonePrimary    String?
  whatsappNumber  String?
  email           String?
  website         String?
  instagramHandle String?
  pricingTier     PricingTier          @default(STANDARD)
  salesRepId      String? // FK para User (membership do CRM)

  // Comercial
  creditLimitEur            Decimal           @default(0) @db.Decimal(12, 2)
  paymentTermDays           Int               @default(0)
  preferredChannel          PreferredChannel?
  preferredDeliveryDay      DayOfWeek?
  shopSizeSqm               Int?
  estimatedMonthlyVolumeEur Decimal?          @db.Decimal(12, 2)

  // Sazonalidade
  peakSeasons String[] @default([])

  // Status
  status           CustomerStatus @default(ACTIVE)
  churnRiskScore   Decimal?       @db.Decimal(5, 2)
  firstOrderAt     DateTime?
  lastOrderAt      DateTime?
  lifetimeValueEur Decimal        @default(0) @db.Decimal(14, 2)

  // Geografia
  geoLat       Decimal? @db.Decimal(9, 6)
  geoLng       Decimal? @db.Decimal(9, 6)
  deliveryZone String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesRep           User?                  @relation("CustomerSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  activities         CustomerActivity[]
  leadsConvertedFrom CustomerLead[]         @relation("ConvertedToCustomer")
  specialPrices      CustomerSpecialPrice[]
  orders             CustomerOrder[]
  quotes             Quote[]
  invoices           Invoice[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, salesRepId])
  @@index([organizationId, pricingTier])
  @@map("customer")
}

// ----------------------------------------------------------------------------
// Domínio Fase 1 — CustomerLead (Kanban) (§10.3)
// ----------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATING
  WON
  LOST
}

enum LeadSource {
  REFERRAL
  WEBSITE
  INSTAGRAM
  COLD_OUTREACH
  EVENT_FAIR
  GOOGLE_PLACES
  OTHER
}

model CustomerLead {
  id                        String                @id @default(cuid())
  organizationId            String
  tradingName               String
  legalName                 String?
  email                     String?
  phone                     String?
  whatsappNumber            String?
  source                    LeadSource            @default(OTHER)
  businessType              CustomerBusinessType?
  instagramHandle           String?
  instagramFollowers        Int?
  shopSizeSqm               Int?
  estimatedMonthlyVolumeEur Decimal?              @db.Decimal(12, 2)
  geoZone                   String?
  notes                     String?

  status     LeadStatus @default(NEW)
  // Score derivado (recomputed em hooks); 0-100.
  score      Int        @default(0)
  salesRepId String?

  convertedAt           DateTime?
  convertedToCustomerId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesRep            User?        @relation("LeadSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  convertedToCustomer Customer?    @relation("ConvertedToCustomer", fields: [convertedToCustomerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, salesRepId])
  @@map("customer_lead")
}

// ----------------------------------------------------------------------------
// Domínio Fase 1 — CustomerActivity (cronologia unificada) (§10.3)
// ----------------------------------------------------------------------------

enum ActivityKind {
  CALL
  VISIT
  MEETING
  WHATSAPP_IN
  WHATSAPP_OUT
  EMAIL_IN
  EMAIL_OUT
  ORDER_PLACED
  ORDER_DELIVERED
  RETURN_OPENED
  NOTE
  CONVERTED_FROM_LEAD
  STATUS_CHANGED
}

model CustomerActivity {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String
  actorId        String? // User que originou (null = sistema)
  kind           ActivityKind
  // Payload livre por kind (ex.: { leadId } em CONVERTED_FROM_LEAD).
  payload        Json         @default("{}")
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId, occurredAt(sort: Desc)])
  @@index([organizationId, kind])
  @@map("customer_activity")
}

// ----------------------------------------------------------------------------
// Domínio Fase 1 — Products (§10.4, §7.2)
// ----------------------------------------------------------------------------

enum ProductCategory {
  DRY_FLOWERS
  PRESERVED_FLOWERS
  VASES_CONTAINERS
  FLORAL_FOAM
  RIBBONS_PACKAGING
  TOOLS_ACCESSORIES
  ARTIFICIAL_PLANTS
  DECORATIVE_OBJECTS
}

enum MaterialPrimary {
  GLASS
  CERAMIC
  METAL
  WOOD
  NATURAL_FIBER
  FOAM
  RESIN
  PLASTIC
  TEXTILE
  PAPER
  OTHER
}

enum ProductFinish {
  MATTE
  GLOSSY
  RUSTIC
  METALLIC
  TEXTURED
  TRANSPARENT
}

enum VisualStyle {
  RUSTIC
  ROMANTIC
  MODERN
  MINIMALIST
  BOHO
  CLASSIC
  FUNERAL
}

enum HumiditySensitivity {
  LOW
  MEDIUM
  HIGH
}

enum ProductDecision {
  PENDING
  APPROVED
  REJECTED
  DISCONTINUED
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
  COMING_SOON
}

model Product {
  id               String          @id @default(cuid())
  organizationId   String
  sku              String
  name             String
  slug             String
  category         ProductCategory
  subcategory      String?
  description      String? // rich text
  shortDescription String?

  brand         String?
  supplierId    String?
  supplierSku   String?
  originCountry String? @db.Char(2)

  // Físicos
  heightCm        Decimal?         @db.Decimal(8, 2)
  widthCm         Decimal?         @db.Decimal(8, 2)
  depthCm         Decimal?         @db.Decimal(8, 2)
  weightG         Decimal?         @db.Decimal(10, 2)
  materialPrimary MaterialPrimary?
  finish          ProductFinish?

  // Visuais (AI vision)
  dominantColor   String?
  secondaryColors String[]     @default([])
  visualStyle     VisualStyle?

  // Flores secas/preservadas
  isPreserved           Boolean              @default(false)
  isDried               Boolean              @default(false)
  botanicalName         String?
  shelfLifeMonths       Int?
  sensitivityToHumidity HumiditySensitivity?
  batchOriginDate       DateTime?

  // Sazonalidade
  seasonality String[] @default([])
  peakMonths  Int[]    @default([])

  // Comercial
  costEur              Decimal  @db.Decimal(12, 2)
  recommendedRetailEur Decimal? @db.Decimal(12, 2)
  moq                  Int      @default(1)
  caseSize             Int      @default(1)
  leadTimeDays         Int?

  // Decisão multi-sócio
  score       Decimal?        @db.Decimal(4, 2) // 0-10
  visualScore Decimal?        @db.Decimal(4, 2)
  comment     String?
  decision    ProductDecision @default(PENDING)
  isAnchor    Boolean         @default(false) // §Anexo B "peça âncora"

  // Estado
  status      ProductStatus @default(ACTIVE)
  firstSeenAt DateTime      @default(now())
  lastSoldAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  media        ProductMedia[]
  votes        ProductVote[]

  @@unique([organizationId, sku])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, decision])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@map("product")
}

model ProductVariant {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  sku            String
  label          String // ex.: "Grande / Bege"
  attributes     Json     @default("{}") // { color, size, finish, ... }
  costEur        Decimal? @db.Decimal(12, 2)
  weightG        Decimal? @db.Decimal(10, 2)
  isDefault      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels           StockLevel[]
  stockMovements        StockMovement[]
  priceListLines        PriceListLine[]
  customerSpecialPrices CustomerSpecialPrice[]
  orderLines            CustomerOrderLine[]
  returnLines           ReturnLine[]
  quoteLines            QuoteLine[]
  alibabaItems          AlibabaOrderItem[]
  invoiceLines          InvoiceLine[]

  @@unique([organizationId, sku])
  @@index([productId])
  @@map("product_variant")
}

enum MediaKind {
  PHOTO
  VIDEO
  TECH_SHEET
}

model ProductMedia {
  id             String    @id @default(cuid())
  organizationId String
  productId      String
  kind           MediaKind @default(PHOTO)
  url            String
  altText        String?
  position       Int       @default(0)
  // AI vision output
  visionTags     String[]  @default([])
  qualityIssues  String[]  @default([])

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model ProductVote {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  userId         String
  score          Decimal  @db.Decimal(4, 2) // 0-10
  visualScore    Decimal? @db.Decimal(4, 2)
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([organizationId, productId])
  @@map("product_vote")
}

// ----------------------------------------------------------------------------
// Domínio Fase 1 — Bundle (kit promocional)
// ----------------------------------------------------------------------------

model Bundle {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  // Conteúdo: [{ productId, variantId?, qty }]
  items          Json     @default("[]")
  priceEur       Decimal? @db.Decimal(12, 2)
  seasonalityTag String?
  active         Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("bundle")
}

// ----------------------------------------------------------------------------
// AuditLog (§9 hard invariant — mutations sensíveis registadas)
// ----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String? // null = sistema
  entityType     String // "customer" | "supplier" | "product" | ...
  entityId       String
  action         String // "CREATE" | "UPDATE" | "DELETE" | "RESTORE"
  changes        Json? // diff seletivo
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@map("audit_log")
}

// ----------------------------------------------------------------------------
// Domínio Fase 2 — Stock (§10.13, §7.5)
//
// Convenção: `qty` em StockMovement é SEMPRE positivo; a direção é dada pelo
// `kind`. Saldo autoritativo vive em StockLevel (nunca derivado por SUM).
// Reservas: usar SELECT … FOR UPDATE via `tx.$queryRaw` (tagged template,
// não Unsafe) dentro de prisma.$transaction.
// ----------------------------------------------------------------------------

enum StockMovementKind {
  IN
  OUT
  RESERVE
  RELEASE
  ADJUST
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
}

enum StockMovementRefType {
  ORDER
  QUOTE
  PURCHASE
  RETURN_DOC
  ADJUSTMENT
  TRANSFER
  NONE
}

model StockLocation {
  id             String   @id @default(cuid())
  organizationId String
  code           String // ex.: PT_PORTO, PT_LISBOA, ES_BARCELONA
  name           String
  country        String   @db.Char(2)
  isDefault      Boolean  @default(false)
  // Armazém de quarentena para devoluções (§10.18). No máximo um por org (lazy).
  isQuarantine   Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  alibabaItems   AlibabaOrderItem[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("stock_location")
}

model StockLevel {
  id               String    @id @default(cuid())
  organizationId   String
  variantId        String
  locationId       String
  available        Int       @default(0)
  reserved         Int       @default(0)
  safetyStock      Int       @default(0)
  expectedExpiryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location     StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // CHECK constraints (available>=0, reserved>=0) acrescentadas no migration.sql.
  @@unique([variantId, locationId])
  @@index([organizationId, locationId])
  @@map("stock_level")
}

model StockMovement {
  id             String               @id @default(cuid())
  organizationId String
  variantId      String
  locationId     String
  kind           StockMovementKind
  // SEMPRE positivo; direção pelo kind. CHECK qty>0 no migration.sql.
  qty            Int
  refType        StockMovementRefType @default(NONE)
  refId          String?
  batch          String?
  reason         String?
  actorId        String?
  occurredAt     DateTime             @default(now())
  createdAt      DateTime             @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location     StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  actor        User?          @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, variantId, occurredAt(sort: Desc)])
  @@index([organizationId, refType, refId])
  @@index([organizationId, kind])
  @@map("stock_movement")
}

// ----------------------------------------------------------------------------
// Domínio Fase 2 — Pricing (§10.15, §10.4)
//
// Floor: cada PriceListLine.unitPriceEur deve ser >= variant.costEur × 1.10.
// Validação no service (domain `enforceFloor`), não em CHECK, porque depende
// de variant cruzado. Ordens (Fase 3) snapshotam o preço resolvido.
// ----------------------------------------------------------------------------

enum PriceListStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PriceListCurrency {
  EUR
}

model PriceList {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  tier           PricingTier
  currency       PriceListCurrency @default(EUR)
  validFrom      DateTime
  validUntil     DateTime?
  status         PriceListStatus   @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        PriceListLine[]

  @@unique([organizationId, tier, validFrom])
  @@index([organizationId, tier, status])
  @@map("price_list")
}

model PriceListLine {
  id             String  @id @default(cuid())
  organizationId String
  priceListId    String
  variantId      String
  unitPriceEur   Decimal @db.Decimal(12, 2)
  minQty         Int     @default(1)
  // Quebras: [{ minQty: int>=minQty, discountPct: 0..0.30 }]
  discountBreaks Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceList    PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId, minQty])
  @@index([organizationId, variantId])
  @@map("price_list_line")
}

model CustomerSpecialPrice {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  variantId      String
  unitPriceEur   Decimal   @db.Decimal(12, 2)
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  reason         String?
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("SpecialPriceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([customerId, variantId, validFrom])
  @@index([organizationId, customerId, variantId])
  @@map("customer_special_price")
}

// Fase 3: Encomendas de cliente. FSM completa definida no enum (fatia 1 usa só DRAFT);
//          CustomerOrderLine guarda snapshots imutáveis de preço/desconto/IVA (§7.5).
enum OrderStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_RECEIVED
  REFUNDED
  REPLACED
}

enum ShipmentCarrier {
  CTT
  DPD
  CHRONOPOST
  OTHER
}

model CustomerOrder {
  id                    String           @id @default(cuid())
  organizationId        String
  orderNumber           String
  customerId            String
  salesRepId            String?
  status                OrderStatus      @default(DRAFT)
  currency              String           @default("EUR") @db.Char(3)
  subtotalEur           Decimal          @default(0) @db.Decimal(14, 2)
  vatEur                Decimal          @default(0) @db.Decimal(14, 2)
  totalEur              Decimal          @default(0) @db.Decimal(14, 2)
  notes                 String?
  requestedDeliveryDate DateTime?
  shippingAddress       Json?
  carrier               ShipmentCarrier?
  trackingCode          String?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesRep     User?                @relation("CustomerOrderSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  lines        CustomerOrderLine[]
  history      OrderStatusHistory[]
  returns      Return[]
  invoice      Invoice?

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, salesRepId])
  @@map("customer_order")
}

model CustomerOrderLine {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  variantId      String
  qty            Int
  unitPriceEur   Decimal  @db.Decimal(12, 2)
  discountPct    Decimal  @default(0) @db.Decimal(5, 4)
  vatPct         Decimal  @default(0) @db.Decimal(5, 2)
  lineTotalEur   Decimal  @db.Decimal(14, 2)
  priceSource    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order   CustomerOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([organizationId, orderId])
  @@map("customer_order_line")
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  organizationId String
  orderId        String
  fromStatus     OrderStatus?
  toStatus       OrderStatus
  actorId        String?
  reason         String?
  createdAt      DateTime     @default(now())

  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@map("order_status_history")
}

// Devoluções (§10.18). Workflow próprio; o estado da encomenda é espelho derivado.
// FSM mantida em lockstep com o caminho de devolução do CustomerOrder
// (§10.14 few-shot 3): REQUESTED → RECEIVED → REFUNDED | REPLACED.
enum ReturnStatus {
  REQUESTED
  RECEIVED
  REFUNDED
  REPLACED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  QUALITY
  SURPLUS
  OTHER
}

enum ReturnDisposition {
  RESTOCK
  SCRAP
}

model Return {
  id             String       @id @default(cuid())
  organizationId String
  orderId        String
  returnNumber   String // DEV-{ano}-{seq}
  status         ReturnStatus @default(REQUESTED)
  reason         ReturnReason
  notes          String?
  // actorId sem relação (espelha OrderStatusHistory.actorId) para não tocar User.
  actorId        String?
  receivedAt     DateTime?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines        ReturnLine[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, status])
  @@index([organizationId, orderId])
  @@map("return")
}

model ReturnLine {
  id              String             @id @default(cuid())
  organizationId  String
  returnId        String
  variantId       String
  qty             Int
  disposition     ReturnDisposition?
  photos          String[]
  inspectionNotes String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  return  Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([returnId, variantId])
  @@index([organizationId, returnId])
  @@map("return_line")
}

// Propostas (§7 "Quote"). Convertem em CustomerOrder ao aceitar, transportando os
// snapshots de preço por linha. FSM própria; sem efeito de stock (a reserva continua
// a acontecer só no CONFIRMED da encomenda).
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Quote {
  id               String      @id @default(cuid())
  organizationId   String
  quoteNumber      String // ORC-{ano}-{seq}
  customerId       String
  // salesRepId sem relação (espelha OrderStatusHistory.actorId) para não tocar User.
  salesRepId       String?
  status           QuoteStatus @default(DRAFT)
  currency         String      @default("EUR") @db.Char(3)
  subtotalEur      Decimal     @default(0) @db.Decimal(14, 2)
  vatEur           Decimal     @default(0) @db.Decimal(14, 2)
  totalEur         Decimal     @default(0) @db.Decimal(14, 2)
  notes            String?
  validUntil       DateTime?
  // Encomenda gerada ao aceitar (sem relação — id opaco, evita backref em CustomerOrder).
  convertedOrderId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines        QuoteLine[]

  @@unique([organizationId, quoteNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@map("quote")
}

model QuoteLine {
  id             String   @id @default(cuid())
  organizationId String
  quoteId        String
  variantId      String
  qty            Int
  unitPriceEur   Decimal  @db.Decimal(12, 2)
  discountPct    Decimal  @default(0) @db.Decimal(5, 4)
  vatPct         Decimal  @default(0) @db.Decimal(5, 2)
  lineTotalEur   Decimal  @db.Decimal(14, 2)
  priceSource    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quote   Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([quoteId, variantId])
  @@index([organizationId, quoteId])
  @@map("quote_line")
}

// ----------------------------------------------------------------------------
// Domínio Fase 3 — Encomendas Alibaba → Stock (§10.12)
//
// Importação de stock upstream. INVARIANTE: stock incrementado EXATAMENTE uma
// vez por encomenda, no gate de transição * → DELIVERED. A guarda `stockAppliedAt`
// (preenchida na 1ª aplicação) torna o sync idempotente mesmo com polls repetidos
// ou corrida entre poller e endpoint manual.
// ----------------------------------------------------------------------------

enum AlibabaOrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model AlibabaOrder {
  id              String             @id @default(cuid())
  organizationId  String
  // ID no lado da Alibaba — fonte de verdade para idempotência (upsert por externalId).
  externalId      String
  supplierId      String?
  status          AlibabaOrderStatus @default(PLACED)
  currency        String?            @db.Char(3)
  placedAt        DateTime?
  expectedArrival DateTime?
  deliveredAt     DateTime?
  // Preenchido quando os StockMovement IN são criados. NULL = stock ainda não aplicado.
  stockAppliedAt  DateTime?
  // Payload bruto do último sync (debug). Sem PII de pessoas; sem máscara necessária.
  raw             Json?
  lastSyncedAt    DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items        AlibabaOrderItem[]

  @@unique([organizationId, externalId])
  @@index([organizationId, status])
  @@map("alibaba_order")
}

model AlibabaOrderItem {
  id             String   @id @default(cuid())
  organizationId String
  alibabaOrderId String
  variantId      String
  // Armazém de destino do IN. Se NULL, o serviço usa a location default da org.
  locationId     String?
  qty            Int
  unitCostEur    Decimal? @db.Decimal(12, 2)
  batch          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order    AlibabaOrder   @relation(fields: [alibabaOrderId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([alibabaOrderId, variantId])
  @@index([organizationId, alibabaOrderId])
  @@map("alibaba_order_item")
}

// ----------------------------------------------------------------------------
// Domínio Fase 3 — Faturação (§10.14)
//
// INVARIANTES: uma fatura por encomenda (orderId @unique); totais são snapshots
// (imunes a alterações futuras de preço/encomenda); número fiscal sequencial por
// org/ano atribuído na emissão; pagamentos nunca excedem o total em aberto.
// ----------------------------------------------------------------------------

enum InvoiceStatus {
  PENDING
  ISSUED
  PAID
  VOID
}

enum PaymentMethod {
  TRANSFER
  CARD
  CASH
  OTHER
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  orderId        String        @unique
  customerId     String
  status         InvoiceStatus @default(PENDING)
  // Número fiscal FT-AAAA-NNNN — só existe a partir de ISSUED.
  number         String?
  // Referência do provider externo (mock: "mock-<id>"; real: id Moloni/InvoiceXpress).
  externalId     String?
  provider       String?
  currency       String        @default("EUR") @db.Char(3)
  subtotalEur    Decimal       @db.Decimal(14, 2)
  vatEur         Decimal       @db.Decimal(14, 2)
  totalEur       Decimal       @db.Decimal(14, 2)
  paidEur        Decimal       @default(0) @db.Decimal(14, 2)
  issuedAt       DateTime?
  dueAt          DateTime?
  raw            Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@map("invoice")
}

model InvoiceLine {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  variantId      String
  description    String
  qty            Int
  unitPriceEur   Decimal  @db.Decimal(12, 2)
  discountPct    Decimal  @default(0) @db.Decimal(5, 4)
  vatPct         Decimal  @default(0) @db.Decimal(5, 2)
  lineTotalEur   Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  invoice Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([organizationId, invoiceId])
  @@map("invoice_line")
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  amountEur      Decimal       @db.Decimal(14, 2)
  method         PaymentMethod @default(TRANSFER)
  reference      String?
  paidAt         DateTime      @default(now())
  actorId        String?
  createdAt      DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actor   User?   @relation("PaymentActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, invoiceId])
  @@map("payment")
}

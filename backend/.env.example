NODE_ENV=development
PORT=3001
LOG_LEVEL=info

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

BETTER_AUTH_SECRET="change-me-min-32-chars-aaaaaaaaaaaaaaaaaaaa"
BETTER_AUTH_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:5173"

# Sync Alibaba → stock (§10.12)
# mock = fixture local (default); live = exige integração real (ainda stub)
ALIBABA_API_MODE=mock
# Poller automático em background. Desligado por defeito; sync manual via POST /api/alibaba/sync
ALIBABA_SYNC_ENABLED=false
ALIBABA_SYNC_INTERVAL_MS=300000
